# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls (text analysis, example-sentence generation, quiz enrichment).
# Get a key at https://platform.deepseek.com and set it in the Vercel project's Environment Variables (Production).
# NOTE: Environment variables only take effect on new deployments. After adding/changing a key, trigger a Redeploy.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_MODEL: Optional. Model identifier used for DeepSeek API calls.
# Defaults to "deepseek-v4-flash" if not set.
DEEPSEEK_MODEL="deepseek-v4-flash"

# Required on Vercel/non-Google servers: JSON service-account credentials for
# english-word-master-app, with Firebase Auth read and Firestore read/write access.
# Alternatively configure Application Default Credentials on the server.
# Never put these credentials or DEEPSEEK_API_KEY in VITE_* variables.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"english-word-master-app","client_email":"...","private_key":"..."}'

# Daily reserved model calls (UTC reset). Zero disables paid calls.
# Failed/aborted calls and unused reservation capacity are not refunded.
AI_USER_DAILY_CALLS="50"
AI_GLOBAL_DAILY_CALLS="1000"

# WORD_LIBRARY_REPO: GitHub repo for word library (default: lilinji/English)
# For enriched library: your-user/english-word-enriched
# WORD_LIBRARY_FORMAT: auto | enriched | xlsx
# WORD_LIBRARY_LOCAL_PATH: Local enriched package path (default: ./data/english-word-enriched)
# WORD_LIBRARY_REPO="lilinji/English"
# WORD_LIBRARY_FORMAT="auto"
# WORD_LIBRARY_LOCAL_PATH="./data/english-word-enriched"
# ENRICH_CHUNK_SIZE_LIGHT: Words per AI call in light mode, capped at 35.
# ENRICH_CHUNK_SIZE: Words per full AI call, capped at 15.
# ENRICH_CONCURRENCY: Parallel AI calls per request, capped at 3.
# ENRICH_CHUNK_SIZE="15"
# ENRICH_CHUNK_SIZE_LIGHT="35"
# ENRICH_CONCURRENCY="3"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
