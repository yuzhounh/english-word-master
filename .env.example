# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls (text analysis, example-sentence generation, quiz enrichment).
# Get a key at https://platform.deepseek.com and set it in the Vercel project's Environment Variables (Production).
# NOTE: Environment variables only take effect on new deployments. After adding/changing a key, trigger a Redeploy.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_MODEL: Optional. Model identifier used for DeepSeek API calls.
# Defaults to "deepseek-v4-flash" if not set.
DEEPSEEK_MODEL="deepseek-v4-flash"

# WORD_LIBRARY_REPO: GitHub repo for word library (default: lilinji/English)
# For enriched library: your-user/english-word-enriched
# WORD_LIBRARY_FORMAT: auto | enriched | xlsx
# WORD_LIBRARY_LOCAL_PATH: Local enriched package path (default: ./data/english-word-enriched)
# WORD_LIBRARY_REPO="lilinji/English"
# WORD_LIBRARY_FORMAT="auto"
# WORD_LIBRARY_LOCAL_PATH="./data/english-word-enriched"
# ENRICH_CHUNK_SIZE_LIGHT: Words per AI call in light mode (no quiz options, faster).
# ENRICH_CONCURRENCY: Parallel AI calls per serverless invocation.
# ENRICH_CHUNK_SIZE="15"
# ENRICH_CHUNK_SIZE_LIGHT="35"
# ENRICH_CONCURRENCY="3"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
